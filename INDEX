/* ---------- Memory garden ---------- */
let memoryCards=[];
let selectedCards=[];
let matches=0;
let turns=0;
let memoryLocked=false;
let memoryTimer;
function shuffle(items){
  const result=[...items];
  for(let i=result.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [result[i],result[j]]=[result[j],result[i]];
  }
  return result;
}
function updateMemoryStatus(){
  $("#memory-status").textContent=matches===6?
    "All six pairs found! A lovely bit of exploring. 🍌":
    `${matches} of 6 pairs · ${turns} turns · take your time`;
}
function startMemory(){
  clearTimeout(memoryTimer);
  selectedCards=[];matches=0;turns=0;memoryLocked=false;
  const icons=["🍌","🍓","🌻","🍄","🥝","🦋"];
  const names={"🍌":"banana","🍓":"strawberry","🌻":"sunflower","🍄":"mushroom","🥝":"kiwi","🦋":"butterfly"};
  memoryCards=shuffle([...icons,...icons]).map(icon=>({icon,matched:false,button:null}));
  $("#memory-grid").replaceChildren();
  memoryCards.forEach((card,index)=>{
    const button=document.createElement("button");
    card.button=button;button.className="memory-card";
    button.textContent="✿";
    button.setAttribute("aria-label",`Card ${index+1}, face down`);
    button.onclick=()=>{
      if(memoryLocked || card.matched || selectedCards.includes(index)) return;
      button.textContent=card.icon;
      button.setAttribute("aria-label",`Card ${index+1}, ${names[card.icon]}`);
      selectedCards.push(index);
      if(selectedCards.length<2) return;
      turns++;
      const [a,b]=selectedCards.map(i=>memoryCards[i]);
      if(a.icon===b.icon){
        a.matched=b.matched=true;
        a.button.classList.add("matched");
        b.button.classList.add("matched");
        a.button.disabled=b.button.disabled=true;
        matches++;selectedCards=[];
        chime([659.25,783.99]);
        updateMemoryStatus();
        if(matches===6){
          act("dance",6500,"Six pairs! A bunch of good noticing. 🍌","Celebrating your game");
        }
      }else{
        memoryLocked=true;
        updateMemoryStatus();
        memoryTimer=setTimeout(()=>{
          selectedCards.forEach(i=>{
            memoryCards[i].button.textContent="✿";
            memoryCards[i].button.setAttribute("aria-label",`Card ${i+1}, face down`);
          });
          selectedCards=[];memoryLocked=false;
        },1000);
      }
    };
    $("#memory-grid").append(button);
  });
  updateMemoryStatus();
}
$("#open-memory").onclick=()=>{
  startMemory();openDialog("#memory-dialog");
};
$("#restart-memory").onclick=startMemory;
$("#memory-dialog").addEventListener("close",()=>{
  clearTimeout(memoryTimer);
});

/* ---------- A gentle minute, based on elapsed time ---------- */
let breathTimer;
let breathStart=0;
let breathPhase=-1;
const breathPrompts=[
  "Feel the support of the chair or floor, if comfortable.",
  "Let your breathing find its own easy rhythm.",
  "Notice a color or shape somewhere around you.",
  "Soften your jaw or shoulders, if that feels okay.",
  "Name one small kindness you could offer yourself.",
  "Nothing to solve right now. Just this moment."
];
function finishBreath(completed=false){
  clearInterval(breathTimer);
  $("#breath-circle").classList.remove("active");
  $("#start-breath").hidden=false;
  $("#end-breath").hidden=true;
  $("#breath-status").textContent=completed?
    "That's your minute. Take whatever pace feels right from here.":
    "Pause finished. You can return whenever you like.";
  if(completed){
    petSay("A little space can be enough. 🌿","Feeling peaceful");
    chime([392,523.25]);
  }
}
$("#open-breath").onclick=()=>openDialog("#breath-dialog");
$("#start-breath").onclick=()=>{
  stopSpeech();
  clearInterval(breathTimer);
  breathStart=Date.now();breathPhase=-1;
  $("#start-breath").hidden=true;
  $("#end-breath").hidden=false;
  $("#breath-circle").classList.add("active");
  function tick(){
    const seconds=(Date.now()-breathStart)/1000;
    if(seconds>=60){finishBreath(true);return;}
    const phase=Math.min(5,Math.floor(seconds/10));
    if(phase!==breathPhase){
      breathPhase=phase;
      $("#breath-status").textContent=breathPrompts[phase];
    }
  }
  tick();
  breathTimer=setInterval(tick,250);
};
$("#end-breath").onclick=()=>finishBreath(false);
$("#breath-dialog").addEventListener("close",()=>finishBreath(false));

