<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#f5f2e8">
<meta name="referrer" content="no-referrer">
<title>BOB — Little monkey, big heart</title>
<style>
:root{
  --bg:#f5f2e8;--card:#fffef9;--ink:#293b31;--muted:#697563;
  --line:#e1e5d7;--green:#365c44;--light:#edf2e4;--gold:#dab56e;
  --shadow:0 12px 34px #283c2507;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
  font:14px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
button,input,textarea,select{font:inherit}
button{cursor:pointer;color:inherit;touch-action:manipulation}
button:disabled{opacity:.5;cursor:not-allowed}
button,a,input,select,textarea{ -webkit-tap-highlight-color:transparent}
:focus-visible{outline:3px solid #b48032;outline-offset:4px}
button{transition:transform .15s,background .15s,box-shadow .15s}
button:not(:disabled):active{transform:translateY(1px)}
a{color:var(--green)}
header,main{max-width:1250px;margin:auto}
header{display:flex;align-items:center;gap:23px;padding:22px 30px;
  border-bottom:1px solid var(--line)}
.logo{font-weight:950;font-size:40px;letter-spacing:-4px;line-height:1}
.logo span{color:#b77e40}
.tagline{font-size:11px;color:var(--muted)}
.header-right{margin-left:auto;display:flex;gap:10px;align-items:center}
.badge{font-size:10px;padding:7px 11px;border:1px solid #dce3ce;
  background:#edf1e3;border-radius:30px}
.icon{border:0;background:transparent;font-size:21px;min-height:40px;min-width:40px;border-radius:9px}
.icon:hover{background:#e7ebdd}
main{padding:0 30px}
.hero{display:flex;align-items:end;justify-content:space-between;gap:24px;padding:31px 0 25px}
.eyebrow{font-size:9px;font-weight:750;letter-spacing:2px;color:#738168}
h1{font:normal 57px/1.04 Georgia,serif;letter-spacing:-2px;margin:13px 0 0}
.hero p{font-size:13px;color:var(--muted);line-height:1.9;margin:0 0 3px}
.workspace{display:grid;grid-template-columns:1.03fr 1fr;gap:22px}
.card{background:var(--card);border:1px solid var(--line);border-radius:22px;
  box-shadow:var(--shadow);overflow:hidden}
.card-head{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:21px 23px 17px}
h2{font-size:23px;letter-spacing:-.6px;margin:5px 0 0}
.subtitle{font-size:11px;font-weight:400;letter-spacing:0;color:var(--muted)}
.level{font-size:8px;letter-spacing:1px;padding:8px;border-radius:7px;white-space:nowrap;
  border:1px solid #e5ddbf;background:#faf5e4}
.scene-wrap{position:relative;margin:0 14px;border-radius:14px;overflow:hidden;background:#dce9d1}
#scene{display:block;width:100%;height:auto;image-rendering:pixelated;aspect-ratio:240/184}
#pet-touch{position:absolute;width:50%;height:62%;left:25%;top:32%;
  border:0;background:transparent;border-radius:30px}
#pet-touch:focus-visible{outline-offset:-5px}
#bubble{position:absolute;top:16px;left:50%;transform:translateX(-50%);
  width:max-content;max-width:91%;padding:10px 15px;border:1px solid #d8dfcb;
  background:#fffef3f5;border-radius:13px;font-size:11px;text-align:center;
  box-shadow:0 3px 8px #27382008;pointer-events:none}
.scene-tools{position:absolute;left:11px;bottom:10px;display:flex;gap:6px}
.scene-tools button{background:#fffef2e8;border:1px solid #ffffff77;padding:6px 9px;
  border-radius:7px;font-size:10px}
.scene-tag{position:absolute;right:13px;bottom:16px;font-size:8px;
  letter-spacing:1px;color:#2f492c;background:#fffce4b8;padding:3px 6px;border-radius:4px}
.pet-bottom{padding:17px 22px 20px}
.mood-row{display:flex;align-items:center;gap:7px;font-size:11px;margin-bottom:15px}
.dot{width:6px;height:6px;background:#769660;border-radius:50%}
#moment{margin-left:auto;color:var(--muted);font-size:9px}
.actions{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.actions button{padding:12px 3px;border:1px solid var(--line);background:#fafbf3;
  border-radius:11px;font-size:10px}
.actions button:hover{background:#eef2e4;transform:translateY(-2px)}
.actions span{display:block;font-size:23px;margin-bottom:5px}
.pet-note{font-size:9px;text-align:center;color:var(--muted);margin:14px 0 0}
.chat{display:flex;flex-direction:column;height:650px}
.tabs{display:flex;gap:4px;margin:0 21px;background:#f0f2e9;padding:4px;border-radius:10px}
.tabs button{flex:1;border:0;background:transparent;padding:10px 3px;border-radius:7px;font-size:11px}
.tabs [aria-pressed=true]{background:#fffef9;font-weight:700;box-shadow:0 2px 5px #25372009}
#mode-note{font-size:9px;color:var(--muted);margin:10px 23px 0}
#messages{flex:1;min-height:0;overflow-y:auto;padding:17px 21px 4px}
.message{max-width:96%;margin-bottom:17px}
.message.user{margin-left:auto}
.label{font-size:9px;letter-spacing:1px;font-weight:700;color:#718065;margin-bottom:6px}
.user .label{text-align:right}
.text{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.75;font-size:12px;
  padding:12px 14px;border-radius:0 12px 12px;background:#eef3e6}
.user .text{background:var(--green);color:#fff;border-radius:12px 0 12px 12px}
.meta{color:var(--muted);font-size:9px;margin-top:5px;line-height:1.7}
.replay{font-size:10px;border:0;background:transparent;padding:4px 1px;color:var(--muted)}
#suggestions{display:flex;gap:6px;flex-wrap:wrap;padding:7px 21px 12px}
#suggestions button{font-size:10px;background:transparent;border:1px solid var(--line);
  border-radius:20px;padding:6px 10px}
#chat-form{padding:0 17px 14px}
.composer{display:flex;align-items:center;gap:5px;border:1px solid #d6dfcd;
  border-radius:12px;padding:7px;background:#fff}
.composer:focus-within{outline:2px solid #91a979}
textarea{flex:1;min-width:0;background:transparent;border:0;resize:none;
  color:var(--ink);padding:6px;font-size:12px;line-height:1.65;outline:none}
#send{height:37px;width:37px;border:0;border-radius:8px;background:var(--green);color:#fff;font-size:23px}
.input-note{display:flex;justify-content:space-between;gap:8px;margin:8px 3px 0;font-size:9px;color:var(--muted)}
.activities{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px}
.activity{display:flex;gap:13px;align-items:center;text-align:left;padding:17px;
  background:var(--card);border:1px solid var(--line);border-radius:13px}
.activity:hover{background:#eef2e4}
.activity .emoji{font-size:27px}
.activity strong{display:block;font-size:12px}
.activity small{font-size:10px;color:var(--muted)}
.activity .arrow{margin-left:auto;color:#819073}
.voice-bar{margin-top:17px;padding:16px 19px;border:1px solid var(--line);
  border-radius:12px;background:#edf0e3;display:flex;align-items:center;
  justify-content:space-between;gap:15px;font-size:11px}
.voice-controls{display:flex;gap:9px;align-items:center;flex-wrap:wrap}
.voice-controls label{display:flex;gap:5px;align-items:center}
select,.small-button{padding:7px;border:1px solid #d4ddc9;background:#fffef9;border-radius:7px;
  font-size:10px;color:var(--ink)}
select{max-width:185px}
input[type=checkbox]{accent-color:var(--green)}
footer{font-size:9px;color:var(--muted);line-height:1.9;padding:21px 0 30px;
  display:flex;justify-content:space-between;gap:20px}
dialog{padding:0;border:1px solid #dce2d1;background:var(--card);color:var(--ink);
  border-radius:20px;max-width:500px;width:calc(100% - 30px);max-height:88vh;
  box-shadow:0 25px 100px #10271838}
dialog::backdrop{background:#1b2e246b;backdrop-filter:blur(4px)}
.dialog-head{display:flex;align-items:center;justify-content:space-between;padding:20px 23px 10px;gap:12px}
.dialog-head h2{font-size:23px}
.dialog-body{padding:8px 23px 25px}
.dialog-body p{font-size:12px;line-height:1.8;color:var(--muted)}
.setting-row{padding:14px 0;border-bottom:1px solid var(--line);display:flex;
  justify-content:space-between;gap:18px;align-items:center;font-size:12px}
.setting-row small{display:block;color:var(--muted);margin-top:3px;font-size:10px}
.primary{background:var(--green);color:white;border:0;border-radius:9px;padding:10px 15px;font-size:12px}
.secondary{background:#f0f3e7;border:1px solid #dce3cf;border-radius:9px;padding:10px 15px;font-size:12px}
.danger{margin-top:17px;color:#874c39}
.game-status{font-size:12px;margin:13px 0;color:var(--muted);min-height:20px}
.memory-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}
.memory-card{aspect-ratio:1;border:1px solid #dbe3cd;border-radius:12px;
  background:#eaf0df;font-size:27px;min-width:0}
.memory-card.matched{background:#dce9cb;border-color:#b9cda4}
.quiz-options{display:grid;gap:8px;margin:15px 0}
.quiz-options button{text-align:left;border:1px solid var(--line);border-radius:9px;
  background:#f1f4e9;padding:11px 14px;font-size:12px}
#quiz-question{font-size:17px;line-height:1.6;color:var(--ink)}
.breath-wrap{display:flex;align-items:center;justify-content:center;height:210px}
.breath-circle{width:145px;height:145px;border-radius:50%;background:#dfeacd;
  border:1px solid #c4d5b0;display:flex;align-items:center;justify-content:center;
  box-shadow:0 0 0 16px #eaf0df,0 0 0 31px #f2f5eb;font-size:24px}
.breath-circle.active{animation:breathe 7s ease-in-out infinite}
@keyframes breathe{50%{transform:scale(1.12)}}
.center{text-align:center}
#breath-status{min-height:42px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
  clip:rect(0,0,0,0);white-space:nowrap;border:0}
body.reduce *,body.reduce *::before,body.reduce *::after{animation:none!important;transition:none!important}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
}
@media(max-width:920px){
  .workspace{grid-template-columns:1fr}
  .hero p{max-width:260px}
  .chat{height:620px}
  .scene-wrap{max-height:none}
  .voice-bar{align-items:flex-start;flex-direction:column}
}
@media(max-width:610px){
  header{padding:19px 16px;gap:12px}main{padding:0 15px}
  .tagline{display:none}.badge{font-size:9px}
  .hero{display:block;padding-top:26px}.hero p{max-width:none;margin-top:18px;font-size:12px}
  h1{font-size:47px}
  .activities{grid-template-columns:1fr;gap:9px}
  .activity{padding:13px 16px}.activity .emoji{font-size:23px}
  .subtitle{display:block;font-size:10px;margin-top:3px}
  .card-head{padding:20px 17px 16px}.level{font-size:7px}
  #moment{display:none}.pet-bottom{padding:16px}
  .tabs{margin:0 15px}#messages{padding-left:15px;padding-right:15px}
  footer{flex-direction:column;gap:6px}
  .scene-tag{display:none}
  .voice-controls{gap:7px}select{max-width:150px}
}
</style>
</head>
<body>
<header>
  <div class="logo" aria-label="BOB">b<span>o</span>b.</div>
  <span class="tagline">a little friend. a curious mind.</span>
  <div class="header-right">
    <span class="badge">● Browser companion</span>
    <button id="open-settings" class="icon" aria-label="Open settings" title="Settings">⚙</button>
  </div>
</header>

<main>
  <section class="hero">
    <div>
      <div class="eyebrow">YOUR LITTLE CORNER OF THE INTERNET</div>
      <h1>Little monkey.<br>A brighter day.</h1>
    </div>
    <p>A soft place to pause. A new thing to learn.<br>
      And a banana-loving buddy along for the ride.<br>
      No streaks. No pressure. Just a little BOB.</p>
  </section>

  <div class="workspace">
    <section class="card" aria-labelledby="bob-title">
      <div class="card-head">
        <div>
          <div class="eyebrow">MEET YOUR PIXEL PAL</div>
          <h2 id="bob-title">BOB <span class="subtitle">small paws, big curiosity</span></h2>
        </div>
        <span class="level">★ CERTIFIED BANANA ENTHUSIAST</span>
      </div>

      <div class="scene-wrap">
        <canvas id="scene" width="240" height="184" role="img"
          aria-label="BOB, a brown pixel monkey with a curly tail, in a leafy garden"></canvas>
        <button id="pet-touch" aria-label="Give BOB a friendly wave" title="Say hello to BOB"></button>
        <div id="bubble" role="status">Hey, you. Glad you're here! 🍌</div>
        <div class="scene-tools">
          <button id="time-button" title="Change day or night">☀ Day</button>
          <button id="weather-button" title="Change the weather">☁ Clear</button>
        </div>
        <span class="scene-tag">BOB'S HAPPY PLACE</span>
      </div>

      <div class="pet-bottom">
        <div class="mood-row">
          <span class="dot"></span><span id="mood">Feeling curious</span>
          <span id="moment">little moments, big smiles</span>
        </div>
        <div class="actions">
          <button id="feed"><span>🍌</span>Snack</button>
          <button id="dance"><span>♪</span>Dance</button>
          <button id="sleep"><span>🌙</span>Rest</button>
          <button id="outfit"><span>👒</span>Outfit</button>
        </div>
        <p class="pet-note">BOB never loses health or happiness when you're away.</p>
      </div>
    </section>

    <section class="card chat" aria-labelledby="chat-title">
      <div class="card-head">
        <div>
          <div class="eyebrow">A LITTLE SPACE FOR YOU</div>
          <h2 id="chat-title">What shall we explore?</h2>
        </div>
        <button id="clear-chat" class="icon" title="Clear conversation" aria-label="Clear conversation">↺</button>
      </div>
      <div class="tabs" role="group" aria-label="Companion mode">
        <button data-mode="support" aria-pressed="true">♡ Support</button>
        <button data-mode="teacher" aria-pressed="false">✧ Teacher</button>
        <button data-mode="encyclopedia" aria-pressed="false">◎ Encyclopedia</button>
      </div>
      <p id="mode-note">Preset exercises, not personalized counseling.</p>
      <div id="messages" role="log" aria-live="polite" aria-relevant="additions"></div>
      <div id="suggestions"></div>
      <form id="chat-form">
        <label class="sr-only" for="question">Message or topic</label>
        <div class="composer">
          <textarea id="question" rows="2" maxlength="500"
            placeholder="Try a calming pause or choose an activity…" required></textarea>
          <button id="send" type="submit" aria-label="Send">↑</button>
        </div>
        <div class="input-note">
          <span>Enter to send · Shift + Enter for a new line</span>
          <span id="chat-status" role="status"></span>
        </div>
      </form>
    </section>
  </div>

  <section class="activities" aria-label="Activities with BOB">
    <button class="activity" id="open-memory">
      <span class="emoji">🍓</span>
      <span><strong>Little memory garden</strong><small>Find the matching pairs. No timer.</small></span>
      <span class="arrow">↗</span>
    </button>
    <button class="activity" id="open-breath">
      <span class="emoji">🌿</span>
      <span><strong>A softer minute</strong><small>A gentle, optional grounding pause.</small></span>
      <span class="arrow">↗</span>
    </button>
    <button class="activity" id="open-quiz">
      <span class="emoji">✨</span>
      <span><strong>Curiosity club</strong><small>Five little questions. Learn as you go.</small></span>
      <span class="arrow">↗</span>
    </button>
  </section>

  <section class="voice-bar" aria-label="BOB voice settings">
    <div><strong>A familiar little voice.</strong> Let BOB read replies aloud.</div>
    <div class="voice-controls">
      <label><input id="read-aloud" type="checkbox"> Read aloud</label>
      <label class="sr-only" for="voice-select">Choose a voice</label>
      <select id="voice-select"><option value="">Device default voice</option></select>
      <button id="preview-voice" class="small-button">Try voice</button>
      <button id="stop-voice" class="icon" title="Stop speaking" aria-label="Stop speaking">■</button>
    </div>
  </section>

  <footer>
    <span>Made for curiosity. Built with a little kindness. 🍌</span>
    <span>Browser edition · Not conversational AI or professional care.
      <a href="#privacy" id="privacy-link">Privacy & limitations</a></span>
  </footer>
</main>

<dialog id="settings-dialog" aria-labelledby="settings-title">
  <div class="dialog-head">
    <h2 id="settings-title">Make yourself at home.</h2>
    <button class="icon" data-close aria-label="Close settings">×</button>
  </div>
  <div class="dialog-body">
    <label class="setting-row">
      <span>Gentle sound effects<small>Quiet generated chimes. Off by default.</small></span>
      <input id="sound-setting" type="checkbox">
    </label>
    <label class="setting-row">
      <span>Less movement<small>Also respects your device's reduced-motion setting.</small></span>
      <input id="motion-setting" type="checkbox">
    </label>
    <label class="setting-row">
      <span>Remember pet preferences<small>Saves outfit, scenery, and motion settings on this browser.</small></span>
      <input id="remember-setting" type="checkbox">
    </label>
    <p id="save-status" role="status"></p>
    <button class="secondary danger" id="reset">Reset pet preferences</button>
    <hr style="border:0;border-top:1px solid var(--line);margin:22px 0">
    <h3 id="privacy">Privacy & honest limitations</h3>
    <p>BOB is a scripted digital pet. Support uses preset exercises; Teacher offers built-in lessons; other knowledge requests search English Wikipedia. This version does not have conversational AI or long-term conversation memory.</p>
    <p>Support text stays on this page. Wikipedia lookups send the topic to Wikipedia. Do not enter confidential work information or sensitive personal details.</p>
    <p>Chat is not saved and disappears on reload. No analytics are included. Optional pet preferences use this browser's local storage. Hosting and external services may retain their own access logs.</p>
    <p>Device voices vary in availability and quality. Some browser voices send text to online speech services. Read-aloud is off each time you open this page.</p>
    <p>Wikipedia excerpts are attributed and linked. They remain subject to Wikipedia's applicable content licenses, including CC BY-SA. Search matches are not guaranteed to answer your question.</p>
    <p>BOB cannot assess distress, diagnose conditions, or provide emergency care. If you are in immediate danger, contact local emergency services or a trusted person nearby.</p>
  </div>
</dialog>

<dialog id="memory-dialog" aria-labelledby="memory-title">
  <div class="dialog-head">
    <h2 id="memory-title">Little memory garden</h2>
    <button class="icon" data-close aria-label="Close memory game">×</button>
  </div>
  <div class="dialog-body">
    <p>Turn over two cards. Find all six pairs, at your own pace.</p>
    <div id="memory-status" class="game-status" role="status"></div>
    <div id="memory-grid" class="memory-grid"></div>
    <p><button id="restart-memory" class="secondary">New garden</button></p>
  </div>
</dialog>

<dialog id="breath-dialog" aria-labelledby="breath-title">
  <div class="dialog-head">
    <h2 id="breath-title">A softer minute</h2>
    <button class="icon" data-close aria-label="Close calming pause">×</button>
  </div>
  <div class="dialog-body center">
    <p>One minute to notice where you are. Breathe naturally—there's no need to match the circle or hold your breath. Skip anything uncomfortable.</p>
    <div class="breath-wrap"><div id="breath-circle" class="breath-circle">🌿</div></div>
    <p id="breath-status" role="status">Nothing to achieve. Just a little space.</p>
    <button id="start-breath" class="primary">Begin a gentle minute</button>
    <button id="end-breath" class="secondary" hidden>Finish now</button>
  </div>
</dialog>

<dialog id="quiz-dialog" aria-labelledby="quiz-title">
  <div class="dialog-head">
    <h2 id="quiz-title">Curiosity club</h2>
    <button class="icon" data-close aria-label="Close quiz">×</button>
  </div>
  <div class="dialog-body">
    <div id="quiz-progress" class="eyebrow"></div>
    <p id="quiz-question"></p>
    <div id="quiz-options" class="quiz-options"></div>
    <p id="quiz-feedback" role="status"></p>
    <button id="quiz-next" class="primary" hidden>Next question</button>
  </div>
</dialog>

<script>
"use strict";

/* ---------- State and safe, optional preferences ---------- */
const $ = selector => document.querySelector(selector);
const all = selector => [...document.querySelectorAll(selector)];
const STORAGE = "bob-garden-preferences-v2";
const motionQuery = matchMedia("(prefers-reduced-motion: reduce)");
const state = {
  night: false, rain: false, outfit: 0, reduce: false,
  remember: false, sound: false, mode: "support",
  action: "idle", actionStart: 0, actionUntil: 0
};
try {
  const saved = JSON.parse(localStorage.getItem(STORAGE) || "null");
  if (saved && saved.remember === true) {
    state.remember = true;
    state.night = saved.night === true;
    state.rain = saved.rain === true;
    state.reduce = saved.reduce === true;
    state.outfit = Number.isInteger(saved.outfit) && saved.outfit >= 0 &&
      saved.outfit <= 3 ? saved.outfit : 0;
  }
} catch {}

function lessMotion() {
  return state.reduce || motionQuery.matches;
}
function savePreferences() {
  try {
    if (state.remember) {
      localStorage.setItem(STORAGE, JSON.stringify({
        remember: true, night: state.night, rain: state.rain,
        outfit: state.outfit, reduce: state.reduce
      }));
      $("#save-status").textContent = "Pet preferences saved on this browser.";
    } else {
      localStorage.removeItem(STORAGE);
      $("#save-status").textContent = "Preferences are not being saved.";
    }
  } catch {
    $("#save-status").textContent =
      "This browser blocked storage. BOB still works, but preferences may not save.";
  }
}
function syncPreferences() {
  document.body.classList.toggle("reduce", state.reduce);
  $("#time-button").textContent = state.night ? "☾ Night" : "☀ Day";
  $("#weather-button").textContent = state.rain ? "☂ Rain" : "☁ Clear";
  $("#sound-setting").checked = state.sound;
  $("#motion-setting").checked = state.reduce;
  $("#remember-setting").checked = state.remember;
  $("#outfit").setAttribute("aria-label",
    "Change outfit. Current: " + ["green shirt", "sun hat", "red scarf", "flower crown"][state.outfit]);
}
syncPreferences();

/* ---------- Dialogs ---------- */
all("[data-close]").forEach(button => {
  button.onclick = () => button.closest("dialog").close();
});
function openDialog(id) {
  stopSpeech();
  $(id).showModal();
}
