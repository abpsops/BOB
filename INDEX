let lessonCursor=0;
function getLesson(text){
  if(/surprise|random lesson|something new/i.test(text)){
    return lessons[(lessonCursor++)%lessons.length];
  }
  return lessons.find(lesson=>lesson.match.test(text));
}
async function wikipedia(text){
  const topic=text
    .replace(/^(hey bob[,!]?\s*)/i,"")
    .replace(/^(what is|what are|who is|who was|tell me about|explain|define)\s+/i,"")
    .replace(/[?!.]+$/,"").trim().slice(0,180);
  if(!topic){
    reply("Try a specific topic, such as “Saturn,” “ocean currents,” or “Ada Lovelace.”");
    return;
  }
  const url=new URL("https://en.wikipedia.org/w/api.php");
  url.search=new URLSearchParams({
    action:"query",generator:"search",gsrsearch:topic,gsrlimit:"1",
    prop:"extracts|info",exintro:"1",explaintext:"1",exchars:"1800",
    inprop:"url",format:"json",origin:"*"
  });
  const controller=new AbortController();
  const timer=setTimeout(()=>controller.abort(),14000);
  try{
    const response=await fetch(url,{
      signal:controller.signal,credentials:"omit",referrerPolicy:"no-referrer"
    });
    if(!response.ok) throw new Error("Wikipedia unavailable");
    const data=await response.json();
    if(data.error) throw new Error("Wikipedia unavailable");
    const page=Object.values(data.query?.pages || {})[0];
    if(!page?.extract){
      reply(
        "I couldn't find a useful article excerpt for that topic. Try a shorter, more specific subject.\n\nThis edition searches Wikipedia; it can't reason through arbitrary questions.",
        "Wikipedia lookup · no useful match"
      );
      return;
    }
    reply(
      page.title+"\n\n"+page.extract+
      "\n\nThis is a search-matched article excerpt—not a verified answer to every part of your question.",
      "English Wikipedia · CC BY-SA",
      page.fullurl || "https://en.wikipedia.org/?curid="+page.pageid
    );
  }finally{
    clearTimeout(timer);
  }
}
