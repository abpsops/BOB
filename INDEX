function rect(x, y, w, h, color) {
  ctx.fillStyle = color;
  ctx.fillRect(Math.round(x), Math.round(y), w, h);
}
function blockOval(x, y, w, h, color) {
  for (let row = 0; row < h; row++) {
    const normalized = (row + .5 - h / 2) / (h / 2);
    const width = Math.sqrt(Math.max(0, 1 - normalized * normalized)) * w;
    rect(x + (w - width) / 2, y + row, Math.max(1, Math.round(width)), 1, color);
  }
}
function line(x1, y1, x2, y2, width, color) {
  const steps = Math.max(Math.abs(x2-x1), Math.abs(y2-y1), 1);
  for (let i = 0; i <= steps; i++) {
    const t = i / steps;
    rect(x1 + (x2-x1)*t - width/2, y1 + (y2-y1)*t - width/2, width, width, color);
  }
}
function path(points, width, color) {
  for (let i = 1; i < points.length; i++) {
    line(...points[i-1], ...points[i], width, color);
  }
}
function flower(x, y, color) {
  rect(x, y, 1, 7, "#6d8c50");
  rect(x-2, y-3, 5, 5, color);
  rect(x-3, y-2, 7, 3, color);
  rect(x-1, y-1, 3, 2, "#dcb658");
}
function cloud(x, y, color) {
  rect(x, y+5, 29, 6, color);
  rect(x+5, y, 12, 11, color);
  rect(x+15, y+3, 9, 8, color);
}
function banana(x, y) {
  path([[x,y],[x+1,y+6],[x+5,y+10],[x+10,y+11],[x+15,y+7]], 5, "#9d6b2c");
  path([[x,y],[x+2,y+6],[x+7,y+8],[x+12,y+7],[x+15,y+4]], 4, "#f3cf5c");
