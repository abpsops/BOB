    why:"Octopuses are cephalopod mollusks, related to squid and cuttlefish."},
  {q:"What does chlorophyll help plants absorb?",
    a:["Sound","Light","Gravity"],correct:1,
    why:"Chlorophyll absorbs light energy that supports photosynthesis."}
];
let quiz=[];
let quizIndex=0;
let quizScore=0;
let quizAnswered=false;
function startQuiz(){
  quiz=shuffle(quizBank).slice(0,5);
  quizIndex=0;quizScore=0;
  renderQuiz();
}
function renderQuiz(){
  quizAnswered=false;
  $("#quiz-options").replaceChildren();
  $("#quiz-feedback").textContent="";
  $("#quiz-next").hidden=true;
  if(quizIndex>=quiz.length){
    $("#quiz-progress").textContent="A LITTLE MORE CURIOUS";
    $("#quiz-question").textContent=`You got ${quizScore} of ${quiz.length} right.`;
    $("#quiz-feedback").textContent="Every explanation is something learned. Want another little round?";
    $("#quiz-next").textContent="Play again";
    $("#quiz-next").hidden=false;
    act("wave",4500,"Curiosity looks good on you. ✨","Feeling inspired");
    return;
  }
  const question=quiz[quizIndex];
  $("#quiz-progress").textContent=`QUESTION ${quizIndex+1} OF ${quiz.length}`;
  $("#quiz-question").textContent=question.q;
  question.a.forEach((answer,index)=>{
    const button=document.createElement("button");
    button.textContent=answer;
    button.onclick=()=>{
      if(quizAnswered) return;
      quizAnswered=true;
      const correct=index===question.correct;
      if(correct){quizScore++;chime();}
      all("#quiz-options button").forEach(b=>b.disabled=true);
      $("#quiz-feedback").textContent=(correct?"That's right! ":"A useful one to learn! ")+question.why;
      $("#quiz-next").textContent=quizIndex===quiz.length-1?"See your finish":"Next question";
      $("#quiz-next").hidden=false;
      $("#quiz-next").focus();
    };
    $("#quiz-options").append(button);
  });
}
$("#open-quiz").onclick=()=>{
  startQuiz();openDialog("#quiz-dialog");
};
$("#quiz-next").onclick=()=>{
  if(quizIndex>=quiz.length){startQuiz();return;}
  quizIndex++;
  renderQuiz();
};

