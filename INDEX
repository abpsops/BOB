  if(/ground|panic|overwhelm/.test(t)) key="ground";
  else if(/step|stuck|motivat|task/.test(t)) key="step";
  else if(/lonely|alone|friend|connect|sad/.test(t)) key="connect";
  else if(/sleep|bed|tired/.test(t)) key="sleep";
  reply(
    "Here's a preset exercise—not a personalized assessment.\n\n"+supportExercises[key],
    "Preset support · not professional care"
  );
}

