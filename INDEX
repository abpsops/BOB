/* ---------- Speech: opt-in, device-provided voices ---------- */
const synth = window.speechSynthesis;
let voices=[];
let speaking=false;
let speechSession=0;

function stopSpeech(){
  speechSession++;
  if(synth) synth.cancel();
  speaking=false;
}
function speak(text){
  if(!synth || !window.SpeechSynthesisUtterance) return;
  stopSpeech();
  const session=speechSession;
  const utterance=new SpeechSynthesisUtterance(text);
  const voice=voices.find(v=>v.voiceURI===$("#voice-select").value);
  if(voice) utterance.voice=voice;
  utterance.lang=voice?.lang || "en-US";
  utterance.rate=.94;
  utterance.pitch=1.04;
  utterance.onstart=()=>{if(session===speechSession) speaking=true;};
  utterance.onend=()=>{if(session===speechSession) speaking=false;};
  utterance.onerror=event=>{
    if(session!==speechSession) return;
    speaking=false;
    if(!["canceled","interrupted"].includes(event.error)){
      $("#chat-status").textContent="Voice unavailable. Try another voice.";
    }
  };
  synth.speak(utterance);
}
function loadVoices(){
  if(!synth) return;
  const selected=$("#voice-select").value;
  voices=synth.getVoices();
  $("#voice-select").replaceChildren(new Option("Device default voice",""));
  voices.forEach(voice=>{
    $("#voice-select").add(new Option(voice.name+" ("+voice.lang+")",voice.voiceURI));
  });
  if(selected && voices.some(v=>v.voiceURI===selected)){
    $("#voice-select").value=selected;
  }else{
    const preferred=voices.find(v=>/^en/i.test(v.lang) &&
      /samantha|aria|jenny|natural|google/i.test(v.name));
    if(preferred) $("#voice-select").value=preferred.voiceURI;
  }
}
if(synth && window.SpeechSynthesisUtterance){
  loadVoices();
  synth.addEventListener("voiceschanged",loadVoices);
}else{
  $("#read-aloud").disabled=true;
  $("#voice-select").disabled=true;
  $("#preview-voice").disabled=true;
  $("#preview-voice").textContent="Voice unavailable";
}
